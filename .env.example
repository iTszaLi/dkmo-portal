# ── DKMO Portal — environment variables ──────────────────────────────────────
# Copy to .env for local development. NEVER commit real values.

# ── API server (required) ────────────────────────────────────────────────────
# PostgreSQL connection string (e.g. Neon, Supabase, RDS)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random long string used to sign login session cookies (required)
SESSION_SECRET=change-me-to-a-long-random-string

# Shared default password for executive users (required for login).
# Per-user overrides: EXEC_PASSWORD_ADMIN1, EXEC_PASSWORD_<USERNAME>, ...
EXEC_PASSWORD=change-me

# ── API server (optional) ────────────────────────────────────────────────────
# Port the API listens on (defaults to 8080)
PORT=8080
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
# Comma-separated list of extra browser origins allowed to call the API with
# credentials. Not needed when frontend and API share the same Vercel domain.
CORS_ORIGINS=

# ── Document/photo storage (optional) ───────────────────────────────────────
# Enables the Documents module file uploads. On Vercel (or any non-Replit
# host) provide a Google Cloud service-account key as a JSON string plus the
# bucket paths. On Replit these fall back to App Storage automatically.
GCS_CREDENTIALS_JSON=
PRIVATE_OBJECT_DIR=/your-gcs-bucket/private
PUBLIC_OBJECT_SEARCH_PATHS=/your-gcs-bucket/public

# ── Frontend build ───────────────────────────────────────────────────────────
# No frontend env vars are required: the app calls the API with relative
# /api/... URLs, served by the Vercel serverless function (api/index.ts).
