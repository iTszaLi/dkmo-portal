# ── DKMO Portal — environment variables ──────────────────────────────────────
# Copy to .env for local development. NEVER commit real values.

# ── API server (required) ────────────────────────────────────────────────────
# PostgreSQL connection string (e.g. Neon, Supabase, RDS)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random long string used to sign login session cookies (required)
SESSION_SECRET=change-me-to-a-long-random-string

# Shared default password for executive users (required for login).
# Per-user overrides: EXEC_PASSWORD_ADMIN1, EXEC_PASSWORD_<USERNAME>, ...
EXEC_PASSWORD=change-me

# ── API server (optional) ────────────────────────────────────────────────────
# Port the API listens on (defaults to 8080)
PORT=8080
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API with
# credentials (set this to your Vercel domain when the frontend is hosted
# separately, e.g. https://dkmo-portal.vercel.app)
CORS_ORIGINS=

# ── Document/photo storage (Replit App Storage) ─────────────────────────────
# Used by the Documents module for file uploads. These are provisioned
# automatically when the API server runs on Replit; on other hosts the
# Documents upload feature requires an alternative storage backend.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Frontend build (Vercel) ──────────────────────────────────────────────────
# No frontend env vars are required: the app calls the API with relative
# /api/... URLs, and vercel.json proxies them to the API server domain.
