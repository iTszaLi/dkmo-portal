{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/dkmo-portal run build",
  "outputDirectory": "artifacts/dkmo-portal/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://Dkmos.replit.app/api/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
